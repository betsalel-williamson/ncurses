.SH SYNOPSIS
.nf
\fB#include <menu.h>
.PP
\fBint set_menu_spacing(MENU *\fImenu\fP,
                     \fBint \fIspc_description\fB,\fR
                     \fBint \fIspc_rows\fB,\fR
                     \fBint \fIspc_columns\fB);\fR
\fBint menu_spacing(const MENU *\fImenu\fB,\fR
                 \fBint* \fIspc_description\fB,\fR
                 \fBint* \fIspc_rows\fB,\fR
                 \fBint* \fIspc_columns\fB);\fR
.fi
