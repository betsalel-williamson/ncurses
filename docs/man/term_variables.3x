.TH term_variables 3X 2025-11-11 "ncurses @NCURSES_MAJOR@.@NCURSES_MINOR@" "Library calls"
.ie \n(.g \{\
.ds `` \(lq
.ds '' \(rq
.\}
.el \{\
.ie t .ds `` ``
.el   .ds `` ""
.ie t .ds '' ''
.el   .ds '' ""
.\}
.
.so term_variables/01-name.3x
.so term_variables/02-synopsis.3x
.so term_variables/03-description.3x
.so term_variables/04-portability.3x
.so term_variables/05-see-also.3x
