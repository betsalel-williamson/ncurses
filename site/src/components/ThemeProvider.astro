---
// Starlight's theme provider, plus the reader's chosen style (styles.css). Starlight renders it
// inside <head>, so its script runs before the page's first paint and the page never paints in
// the wrong style. It must hold nothing but scripts: an element such as a <div> would end <head>
// there, and the stylesheets after it would land in <body>, where the page paints before they
// load. The status bar is in SkipLink.astro for that reason.
import Default from '@astrojs/starlight/components/ThemeProvider.astro';
import vt323 from '@fontsource/vt323/files/vt323-latin-400-normal.woff2?url';
import arimo400 from '@fontsource/arimo/files/arimo-latin-400-normal.woff2?url';
import arimo700 from '@fontsource/arimo/files/arimo-latin-700-normal.woff2?url';
import gelasio400 from '@fontsource/gelasio/files/gelasio-latin-400-normal.woff2?url';
import gelasio700 from '@fontsource/gelasio/files/gelasio-latin-700-normal.woff2?url';
import tinos400 from '@fontsource/tinos/files/tinos-latin-400-normal.woff2?url';
import tinos400i from '@fontsource/tinos/files/tinos-latin-400-italic.woff2?url';
import tinos700 from '@fontsource/tinos/files/tinos-latin-700-normal.woff2?url';
import cousine400 from '@fontsource/cousine/files/cousine-latin-400-normal.woff2?url';

// The web fonts each style draws its first screen with. A browser finds a font only once the
// stylesheets have loaded and the page is laid out, so it paints the page in a fallback font
// first and swaps when the font arrives. VT323 is far narrower than any fallback, so headings
// shrank and the page jumped, most on phones, where a title wrapped onto a second line. The
// script preloads these alongside the stylesheets, so they are usually in before the first paint.
const fonts = {
  textmode: [vt323],
  workstation: [gelasio400, gelasio700, arimo700, cousine400],
  terminal: [vt323, arimo400, arimo700, cousine400],
  manpage: [tinos400, tinos400i, tinos700, cousine400],
};
---

<Default />

<script is:inline define:vars={{ fonts }}>
  (() => {
    // Styles drawn for one color scheme only. Modern follows the Auto/Light/Dark picker.
    const modes = { textmode: 'dark', workstation: 'light', terminal: 'dark', manpage: 'light' };
    const known = (s) => s === 'modern' || Object.hasOwn(modes, s);
    // A link can name a style (?style=terminal), so whoever follows it sees the page the way
    // the sender did. It counts as choosing that style from the menu, so it's kept from then on.
    const url = new URL(location.href);
    let style = url.searchParams.get('style');
    if (known(style)) {
      try {
        localStorage.setItem('ncurses-style', style === 'modern' ? '' : style);
      } catch {}
    } else {
      style = null;
      try {
        style = localStorage.getItem('ncurses-style');
      } catch {}
    }
    const root = document.documentElement;
    root.dataset.style = style && known(style) ? style : 'modern';
    // Keep the address bar naming the style, so a link copied from it opens in the same one.
    window.ncursesStyleUrl = (s) => {
      const u = new URL(location.href);
      if (s === 'modern') u.searchParams.delete('style');
      else u.searchParams.set('style', s);
      if (u.href !== location.href) history.replaceState(history.state, '', u);
    };
    window.ncursesStyleUrl(root.dataset.style);
    // Keep the color scheme a fixed style needs, whatever Starlight's picker or the system says.
    const force = () => {
      const mode = modes[root.dataset.style];
      if (mode && root.dataset.theme !== mode) root.dataset.theme = mode;
    };
    force();
    for (const href of fonts[root.dataset.style] ?? []) {
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'font';
      link.type = 'font/woff2';
      link.crossOrigin = '';
      link.href = href;
      document.head.append(link);
    }
    new MutationObserver(force).observe(root, { attributes: true, attributeFilter: ['data-theme', 'data-style'] });
  })();
</script>
