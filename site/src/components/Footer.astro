---
// Starlight's footer, plus the page scripts: runnable guide examples (run-example.ts), the home
// page's demo terminal (home-terminal.ts), the header that hides on scroll (chrome-autohide.ts),
// the search field's hint (search-hint.ts) and the search pull-down on desktop (search-panel.ts).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<script>
  import './run-example.ts';
  import './home-terminal.ts';
  import './chrome-autohide.ts';
  import './search-hint.ts';
  import './search-panel.ts';
  // Hints on linked names in the prose; pages with a listing load it from Expressive Code too.
  import './code-hints.js';
</script>

<style is:global>
  .run-example-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  /* Starlight puts a top margin between siblings in page content; in this row it lifted the
     second button and the size menu off the first button's line. */
  .run-example-bar > *,
  .run-example-keys > *,
  .run-example-bar button *,
  .run-example-size > select {
    margin: 0;
  }
  .run-example-bar button {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0.9rem;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  /* One control size on the row: Run, the keys, the Fit toggle, the size menu and Copy to run
     share height, padding, font size and line height. Run is the filled primary; the others
     (.nc-key) are the secondary of the same family, drawn from the --nc-key-* tokens. */
  .run-example-bar button,
  .run-example-size select {
    box-sizing: border-box;
    height: 2.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    padding-block: 0;
    line-height: 1;
    white-space: nowrap;
    vertical-align: middle;
  }
  .run-example-size select {
    display: inline-block;
  }
  .run-example-bar button.nc-key {
    background: var(--nc-key-bg, transparent);
    color: var(--nc-key-fg, var(--sl-color-white));
    border: var(--nc-key-border, 1px solid);
    border-color: var(--nc-key-border-color, var(--sl-color-gray-3));
    box-shadow: var(--nc-key-shadow, none);
  }
  :root[data-theme='light'] .run-example-bar button.nc-key {
    border-color: var(--nc-key-border-color, var(--sl-color-gray-4));
  }
  .run-example-bar .nc-key kbd {
    font: inherit;
    font-weight: 700;
    line-height: 1;
    padding: 0;
    color: var(--nc-key-cap-fg, var(--sl-color-text-accent));
    background: var(--nc-key-cap-bg, transparent);
    font-variant: var(--nc-key-cap-variant, normal);
  }
  .run-example-keys {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .run-example-keys[hidden],
  .run-example-bar [hidden] {
    display: none;
  }
  .run-example-keys .is-arrow {
    min-width: 2.5rem;
    padding-inline: 0.5rem;
  }
  .run-example-bar .run-example-fit {
    padding-inline: 0.6rem;
  }
  .run-example-bar .run-example-fit[aria-pressed='true']::before {
    content: '✓ ';
    white-space: pre;
  }
  /* Copy to run (run-copy.js): the row under a shell listing, with its icon in the key cap's
     color. Modern draws Starlight's round line icons, Manual page thin square-ended lines, and the
     other styles pixel icons. */
  .run-copy-bar {
    margin-top: 0.75rem;
  }
  .run-copy-icon {
    display: contents;
  }
  .run-copy-svg {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    overflow: visible;
    color: var(--nc-key-icon-fg, var(--nc-key-cap-fg, var(--sl-color-text-accent)));
    filter: var(--nc-key-icon-filter, none);
  }
  .run-copy-svg:not(.is-round) {
    display: none;
  }
  :root[data-style='manpage'] .run-copy-svg.is-round,
  :root[data-style]:not([data-style='modern'], [data-style='manpage']) .run-copy-svg.is-round {
    display: none;
  }
  :root[data-style='manpage'] .run-copy-svg.is-square,
  :root[data-style]:not([data-style='modern'], [data-style='manpage']) .run-copy-svg.is-pixel {
    display: block;
  }
  .nc-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .run-example-bar button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .run-example-size {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .run-example-size select {
    font: inherit;
    padding: 0.35rem 0.5rem;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .run-example-note {
    flex-basis: 100%;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  /* The home page's demo terminal (home-terminal.ts), in the hero's image slot. Starlight puts
     that slot above the text in a narrow column and beside it, 25rem wide, on a wide screen; the
     terminal goes below the text on a phone and takes the larger column beside it once the
     window is wide enough for 80 columns at a readable size. */
  .hero > .hero-html:has(.home-terminal) {
    order: 2;
    width: 100%;
    margin: 0;
  }
  @media (min-width: 64rem) {
    .hero:has(> .hero-html .home-terminal:not([hidden])) {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
    }
    /* The title's column is narrower than Starlight's, so its words are set to fit it. */
    .hero:has(> .hero-html .home-terminal:not([hidden])) h1 {
      font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 3.2vw), var(--sl-text-5xl));
      overflow-wrap: anywhere;
    }
  }
  .home-terminal {
    width: 100%;
    min-width: 0;
  }
  .home-terminal .home-terminal-scroller {
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .home-terminal .home-terminal-screen {
    width: auto;
    cursor: text;
  }
  /* The room the terminal takes before it is made, so nothing moves when it is. */
  .home-terminal .home-terminal-screen:empty {
    aspect-ratio: 80 / 25;
  }
  .home-terminal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 0.75rem;
  }
  .home-terminal-bar > * {
    margin: 0;
  }
  .home-terminal-play {
    font: inherit;
    font-size: var(--sl-text-sm);
    box-sizing: border-box;
    height: 2.25rem;
    padding: 0 0.8rem;
    border-radius: 0.4rem;
    cursor: pointer;
    white-space: nowrap;
    background: var(--nc-key-bg, transparent);
    color: var(--nc-key-fg, var(--sl-color-white));
    border: var(--nc-key-border, 1px solid);
    border-color: var(--nc-key-border-color, var(--sl-color-gray-3));
    box-shadow: var(--nc-key-shadow, none);
  }
  .home-terminal-play:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .home-terminal-hint {
    flex: 1 1 14rem;
    font-size: var(--sl-text-sm);
    line-height: 1.4;
    color: var(--sl-color-gray-2);
  }
  .run-example-flag {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    border-left: 3px solid var(--sl-color-orange);
    padding-left: 0.75rem;
  }
  .run-example-scroller {
    margin-top: 0.75rem;
    max-width: 100%;
    overflow-x: auto;
    /* Room for the frame's shadow, which would otherwise be clipped. */
    padding: 0 0.75rem 0.75rem 0;
  }
  /* xterm.js gives its viewport overflow-y: scroll for scrollback, and the browser drew that
     scroll bar beside the screen until the renderer covered it: a flash on every load, and an
     overlay bar on macOS. A curses program draws on the alternate screen, which has no
     scrollback, and the wheel goes to the page (run-example.ts), so the bar has nothing to do. */
  .run-example-screen .xterm-viewport {
    scrollbar-width: none;
  }
  .run-example-screen .xterm-viewport::-webkit-scrollbar {
    display: none;
  }
  .run-example-screen {
    padding: 0.5rem;
    background: #1e1e1e;
    border-radius: 0.4rem;
    width: fit-content;
  }
  /* On a phone every pixel of width is text size for a fitted terminal. */
  @media (max-width: 30rem) {
    .run-example-screen {
      padding: 4px;
    }
    :root[data-style='textmode'] .run-example-screen {
      padding: 8px;
    }
  }
</style>
