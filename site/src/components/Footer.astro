---
// Starlight's footer, plus the script that makes guide examples runnable (run-example.ts).
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default><slot /></Default>

<script>
  import './run-example.ts';
</script>

<style is:global>
  .run-example {
    margin-top: 0.75rem;
  }
  .run-example-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .run-example-bar button {
    font: inherit;
    font-size: var(--sl-text-sm);
    padding: 0.35rem 0.9rem;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    cursor: pointer;
  }
  .run-example-bar button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .run-example-note {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .run-example-flag {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    border-left: 3px solid var(--sl-color-orange);
    padding-left: 0.75rem;
  }
  .run-example-screen {
    margin-top: 0.75rem;
    padding: 0.5rem;
    background: #1e1e1e;
    border-radius: 0.4rem;
    overflow-x: auto;
    width: fit-content;
    max-width: 100%;
  }
</style>
