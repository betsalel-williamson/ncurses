---
// The front page's Migration progress section: how far the move to Merlon Docs shards has got,
// and what it took. Each guide chapter, manual page and contributor document counts once, in
// two steps: sharded, then reviewed against its sources. Every count comes from git through
// scripts/migration-history.mjs, which also checks the per-pull-request history CI verifies.
// The session figures and the tracks' notes are in site/data/migration.json.
import { execFileSync } from 'node:child_process';
import { resolve } from 'node:path';
import { current, readHistory } from '../../scripts/migration-history.mjs';
import data from '../../data/migration.json';

// Astro builds from site/, so the repository is its parent.
const repo = resolve(process.cwd(), '..');
const now = current();
const note = (name: string) => data.tracks.find((t: any) => t.name === name)?.note ?? '';
const tracks = [
  { name: 'Guides', unit: 'chapters', ...now.guides },
  { name: 'Manual pages', unit: 'pages', ...now.man },
  { name: 'Contributor and install docs', unit: 'documents', ...now.contributor },
].map((t) => ({ ...t, note: note(t.name) }));
const total = tracks.reduce((n: number, t: any) => n + t.total, 0);
const sharded = tracks.reduce((n: number, t: any) => n + t.sharded, 0);
const reviewed = tracks.reduce((n: number, t: any) => n + t.reviewed, 0);
// Half a unit for sharding it, the other half for reviewing it.
const percent = (s: number, r: number, of: number) => (of ? Math.round(((s + r) / (2 * of)) * 100) : 0);
const width = (n: number, of: number) => `${of ? (n / of) * 100 : 0}%`;

let merged: number | undefined;
try {
  const log = execFileSync('git', ['log', '--format=%s', 'HEAD'], { cwd: repo, encoding: 'utf8' });
  merged = log.split('\n').filter((s) => /^Merge pull request #\d+ /.test(s)).length;
} catch {}
const errata = now.errata.rows;
const fixed = now.errata.originalErrors;
// The history, newest first, with the overall percentage at each merge.
const history = readHistory()
  .map((r: any) => {
    const ts = [r.guides, r.man, r.contributor];
    const sum = (k: string) => ts.reduce((n: number, t: any) => n + t[k], 0);
    return { ...r, done: percent(sum('sharded'), sum('reviewed'), sum('total')) };
  })
  .reverse();
const repoUrl = `https://github.com/${process.env.GITHUB_REPOSITORY || 'betsalel-williamson/ncurses'}`;

const s = data.session;
const n = new Intl.NumberFormat('en-US');
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const hours = (sec: number) => {
  const h = Math.floor(sec / 3600);
  const m = Math.round((sec % 3600) / 60);
  return h ? `${h} h ${m} min` : `${m} min`;
};
const elapsed = (Date.parse(s.asOf) - Date.parse(s.started)) / 1000;
const days = (sec: number) => {
  const d = Math.floor(sec / 86400);
  const h = Math.round((sec % 86400) / 3600);
  return d ? `${d} d ${h} h` : `${h} h`;
};
const date = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const tokens = s.inputTokens + s.outputTokens + s.cacheReadTokens + s.cacheWriteTokens;
---

<section class="nc-progress" aria-labelledby="nc-progress-title">
  <h2 id="nc-progress-title">Migration progress</h2>
  <p>
    This edition is moving every ncurses document into Merlon Docs shards, then reviewing each one against its sources.
    Each guide chapter, manual page and contributor document counts once, in two steps: sharded, then reviewed.
  </p>

  <p class="nc-progress-total"><strong>{percent(sharded, reviewed, total)}% done</strong>: {sharded} of {total} sharded, {reviewed} of {total} reviewed.</p>
  <div class="nc-bar nc-bar-total" aria-hidden="true">
    <span class="nc-seg nc-seg-reviewed" style={`width: ${width(reviewed, total)}`}></span>
    <span class="nc-seg nc-seg-sharded" style={`width: ${width(sharded - reviewed, total)}`}></span>
  </div>
  <ul class="nc-legend">
    <li><span class="nc-key nc-seg-reviewed"></span>Sharded and reviewed</li>
    <li><span class="nc-key nc-seg-sharded"></span>Sharded, awaiting review</li>
    <li><span class="nc-key nc-seg-todo"></span>Not started</li>
  </ul>

  <dl class="nc-tracks">
    {
      tracks.map((t: any) => (
        <div>
          <dt>
            {t.name} <span>{percent(t.sharded, t.reviewed, t.total)}%</span>
          </dt>
          <dd>
            <div class="nc-bar" aria-hidden="true">
              <span class="nc-seg nc-seg-reviewed" style={`width: ${width(t.reviewed, t.total)}`} />
              <span class="nc-seg nc-seg-sharded" style={`width: ${width(t.sharded - t.reviewed, t.total)}`} />
            </div>
            <p>
              {t.sharded} of {t.total} {t.unit} sharded, {t.reviewed} reviewed. {t.note}
            </p>
          </dd>
        </div>
      ))
    }
  </dl>

  <h3>What it took so far</h3>
  <p>
    One agent session did the work, with the maintainer reviewing and merging each pull request.
    Figures are as of {date(s.asOf)}.
  </p>
  <dl class="nc-stats">
    <div><dt>Tokens</dt><dd>{compact.format(tokens)}</dd><dd class="nc-stat-note">{compact.format(s.outputTokens)} output, {compact.format(s.inputTokens)} input, {compact.format(s.cacheReadTokens)} read from the prompt cache, {compact.format(s.cacheWriteTokens)} written to it</dd></div>
    <div><dt>API cost</dt><dd>${n.format(Math.round(s.costUsd))}</dd><dd class="nc-stat-note">At list prices, as the session reports it</dd></div>
    <div><dt>Wall time</dt><dd>{days(elapsed)}</dd><dd class="nc-stat-note">From the first request to {date(s.asOf)}</dd></div>
    <div><dt>Agent working time</dt><dd>{hours(s.agentActiveSeconds)}</dd><dd class="nc-stat-note">Gaps of 5 minutes or less between the agent's steps; waits for CI and for the maintainer aren't counted</dd></div>
    <div><dt>Maintainer time</dt><dd>{hours(s.maintainerSeconds)}</dd><dd class="nc-stat-note">{s.maintainerMessages} messages; gaps of 15 minutes or less between them, so reading time is undercounted</dd></div>
    {merged !== undefined && <div><dt>Pull requests merged</dt><dd>{merged}</dd><dd class="nc-stat-note">Each one reviewed and merged by the maintainer</dd></div>}
    <div><dt>Errata recorded</dt><dd>{errata}</dd><dd class="nc-stat-note">{fixed} errors in the original text, each checked against the library; see <a href="appendix/">Errata</a></dd></div>
  </dl>

  <h3>Checking these figures</h3>
  <p>
    Every count above comes from git, at build time.
    The history below keeps the same counts for each merged pull request, taken at its merge commit, in
    <a href={`${repoUrl}/blob/master/site/data/migration-history.json`}><code>migration-history.json</code></a>.
    Which pull request reviewed each document is listed in
    <a href={`${repoUrl}/blob/master/site/data/migration-units.csv`}><code>migration-units.csv</code></a>.
    To check both against the repository, clone it and run:
  </p>
  <pre><code>node site/scripts/migration-history.mjs verify</code></pre>
  <p>
    It recounts every row from git and fails on any difference.
    It also checks each review claim: the pull request merged, changed that document, and recorded its corrections in the errata.
    CI runs it on every pull request.
    The token and cost figures are the exception. They come from the agent's session API, and the repository keeps each response's numbers in
    <a href={`${repoUrl}/tree/master/site/data/session`}><code>site/data/session</code></a>, along with a timeline of the session that the time figures are recomputed from.
    <code>node site/scripts/migration-stats.mjs verify</code> checks the figures above against those files.
  </p>
  <details class="nc-history">
    <summary>Progress at each merged pull request</summary>
    <div class="nc-history-scroll">
    <table>
      <thead>
        <tr><th>Pull request</th><th>Merged</th><th>Done</th><th>Guides</th><th>Manual pages</th><th>Contributor docs</th><th>Errata</th></tr>
      </thead>
      <tbody>
        {
          history.map((r: any) => (
            <tr>
              <td><a href={`${repoUrl}/pull/${r.pr}`}>#{r.pr}</a></td>
              <td>{date(r.mergedAt)}</td>
              <td>{r.done}%</td>
              <td>{r.guides.sharded}/{r.guides.reviewed} of {r.guides.total}</td>
              <td>{r.man.sharded}/{r.man.reviewed} of {r.man.total}</td>
              <td>{r.contributor.sharded}/{r.contributor.reviewed} of {r.contributor.total}</td>
              <td>{r.errata.rows}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    </div>
    <p class="nc-stat-note">Each track shows sharded/reviewed of its total.</p>
  </details>
</section>

<style>
  .nc-progress {
    margin-top: 2rem;
  }
  .nc-progress dd {
    margin-inline-start: 0;
  }
  .nc-bar {
    display: flex;
    height: 0.9rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
  }
  .nc-bar-total {
    height: 1.5rem;
  }
  .nc-seg {
    display: block;
    height: 100%;
  }
  .nc-seg-reviewed {
    background: var(--sl-color-accent);
  }
  .nc-seg-sharded {
    background: color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-gray-6));
  }
  .nc-seg-todo {
    background: var(--sl-color-gray-6);
  }
  .nc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
  }
  .nc-legend li {
    margin: 0;
  }
  .nc-key {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-inline-end: 0.4em;
    vertical-align: -0.1em;
    border: 1px solid var(--sl-color-gray-4);
  }
  .nc-tracks dt {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
  }
  .nc-tracks dd {
    margin: 0.25rem 0 0;
  }
  .nc-tracks dd p {
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
  .nc-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }
  .nc-stats > div {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
  .nc-stats dt {
    font-size: var(--sl-text-sm);
  }
  .nc-stats dd {
    margin: 0;
    font-size: var(--sl-text-2xl);
    font-weight: 600;
  }
  .nc-history summary {
    cursor: pointer;
    font-weight: 600;
  }
  .nc-progress pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
  }
  .nc-history-scroll {
    max-width: 100%;
    overflow-x: auto;
  }
  .nc-history table {
    font-size: var(--sl-text-sm);
  }
  .nc-history td,
  .nc-history th {
    white-space: nowrap;
  }
  .nc-stats dd.nc-stat-note,
  .nc-history .nc-stat-note {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-2);
  }
</style>
