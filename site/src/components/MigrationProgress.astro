---
// The front page's Migration progress section: how far the move to Merlon Docs shards has got,
// and what it took. Sharding is counted in documents (each guide chapter, manual page and
// contributor document once); review is counted in tokens, so a long page weighs more than a
// short one. The counts come from git through scripts/migration-history.mjs, which also checks
// the per-pull-request history CI verifies; the tokens come from data/doc-sizes.json.
// The session figures and the tracks' notes are in site/data/migration.json.
import { execFileSync } from 'node:child_process';
import { resolve } from 'node:path';
import { current, readHistory, tokenProgress } from '../../scripts/migration-history.mjs';
import data from '../../data/migration.json';
import sizes from '../../data/doc-sizes.json';

// Astro builds from site/, so the repository is its parent.
const repo = resolve(process.cwd(), '..');
const now = current();
const toks = tokenProgress(sizes);
const note = (name: string) => data.tracks.find((t: any) => t.name === name)?.note ?? '';
const tracks = [
  { name: 'Guides', unit: 'chapters', ...now.guides },
  { name: 'Manual pages', unit: 'pages', ...now.man },
  { name: 'Contributor and install docs', unit: 'documents', ...now.contributor },
].map((t) => ({ ...t, note: note(t.name) }));
const tokKey = { Guides: 'guides', 'Manual pages': 'man', 'Contributor and install docs': 'contributor' } as Record<string, 'guides' | 'man' | 'contributor'>;
const total = tracks.reduce((n: number, t: any) => n + t.total, 0);
const sharded = tracks.reduce((n: number, t: any) => n + t.sharded, 0);
const reviewed = tracks.reduce((n: number, t: any) => n + t.reviewed, 0);
// Half a unit for sharding it, the other half for reviewing it (the history's measure).
const percent = (s: number, r: number, of: number) => (of ? Math.round(((s + r) / (2 * of)) * 100) : 0);
const pct = (n: number, of: number) => (of ? Math.round((n / of) * 100) : 0);
const width = (n: number, of: number) => `${of ? (n / of) * 100 : 0}%`;
// Reviewed tokens per tokenizer, for a track's key or for all of them.
const reviewedTokens = (id: string, key?: string) => {
  const ts = key ? [toks[id][key]] : Object.values(toks[id]);
  return { reviewed: ts.reduce((n: number, t: any) => n + t.reviewed, 0), total: ts.reduce((n: number, t: any) => n + t.total, 0) };
};
// Done: half for the documents sharded, half for the tokens reviewed.
const done = (docs: { sharded: number; total: number }, id: string, key?: string) => {
  const r = reviewedTokens(id, key);
  return Math.round(((docs.total ? docs.sharded / docs.total : 0) + (r.total ? r.reviewed / r.total : 0)) * 50);
};
// Per-tokenizer values for the dropdown to swap in: data-tok holds text, data-tok-width a bar width.
const perTok = (f: (id: string) => string) => JSON.stringify(Object.fromEntries(sizes.tokenizers.map((t: any) => [t.id, f(t.id)])));

let merged: number | undefined;
try {
  const log = execFileSync('git', ['log', '--format=%s', 'HEAD'], { cwd: repo, encoding: 'utf8' });
  merged = log.split('\n').filter((s) => /^Merge pull request #\d+ /.test(s)).length;
} catch {}
const errata = now.errata.rows;
const fixed = now.errata.originalErrors;
// The history, newest first, with the overall percentage at each merge.
const history = readHistory()
  .map((r: any) => {
    const ts = [r.guides, r.man, r.contributor];
    const sum = (k: string) => ts.reduce((n: number, t: any) => n + t[k], 0);
    return { ...r, done: percent(sum('sharded'), sum('reviewed'), sum('total')) };
  })
  .reverse();
const repoUrl = `https://github.com/${process.env.GITHUB_REPOSITORY || 'betsalel-williamson/ncurses'}`;

const s = data.session;
const n = new Intl.NumberFormat('en-US');
const compact = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 });
const hours = (sec: number) => {
  const h = Math.floor(sec / 3600);
  const m = Math.round((sec % 3600) / 60);
  return h ? `${h} h ${m} min` : `${m} min`;
};
const elapsed = (Date.parse(s.asOf) - Date.parse(s.started)) / 1000;
const days = (sec: number) => {
  const d = Math.floor(sec / 86400);
  const h = Math.round((sec % 86400) / 3600);
  return d ? `${d} d ${h} h` : `${h} h`;
};
const date = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
// Sizes before and after, per tokenizer (data/doc-sizes.json, from scripts/doc-sizes.py).
const sizeTotal = (side: 'before' | 'now') =>
  sizes.groups.reduce((acc: any, g: any) => {
    for (const [k, v] of Object.entries(g[side])) if (typeof v === 'number') acc[k] = (acc[k] ?? 0) + v;
    return acc;
  }, {});
const sizeRows = [...sizes.groups, { name: 'All', from: '', before: sizeTotal('before'), now: sizeTotal('now') }];
const change = (a: number, b: number) => (a ? `${b >= a ? '+' : '−'}${Math.abs(Math.round(((b - a) / a) * 100))}%` : '');
const tok0 = sizes.tokenizers[0];
const tokens = s.inputTokens + s.outputTokens + s.cacheReadTokens + s.cacheWriteTokens;
---

<section class="nc-progress" aria-labelledby="nc-progress-title">
  <h2 id="nc-progress-title">Migration progress</h2>
  <p>
    This edition is moving every ncurses document into Merlon Docs shards, then reviewing each one against its sources.
    It counts two steps. Sharding counts documents: each guide chapter, manual page and contributor document once.
    Review counts tokens, so a long manual page weighs more than a short one; the tokenizer picker below changes them.
    Done gives half for the documents sharded and half for the tokens reviewed.
  </p>

  <p class="nc-progress-total"><strong data-tok={perTok((id) => `${done({ sharded, total }, id)}% done`)}>{done({ sharded, total }, tok0.id)}% done</strong></p>
  <p class="nc-bar-label">Sharded: {sharded} of {total} documents ({pct(sharded, total)}%)</p>
  <div class="nc-bar nc-bar-total" aria-hidden="true">
    <span class="nc-seg nc-seg-sharded" style={`width: ${width(sharded, total)}`}></span>
  </div>
  <p class="nc-bar-label" data-tok={perTok((id) => { const r = reviewedTokens(id); return `Reviewed: ${n.format(r.reviewed)} of ${n.format(r.total)} tokens (${pct(r.reviewed, r.total)}%)`; })}>
    Reviewed: {n.format(reviewedTokens(tok0.id).reviewed)} of {n.format(reviewedTokens(tok0.id).total)} tokens ({pct(reviewedTokens(tok0.id).reviewed, reviewedTokens(tok0.id).total)}%)
  </p>
  <div class="nc-bar nc-bar-total" aria-hidden="true">
    <span class="nc-seg nc-seg-reviewed" data-tok-width={perTok((id) => width(reviewedTokens(id).reviewed, reviewedTokens(id).total))} style={`width: ${width(reviewedTokens(tok0.id).reviewed, reviewedTokens(tok0.id).total)}`}></span>
  </div>

  <dl class="nc-tracks">
    {
      tracks.map((t: any) => {
        const k = tokKey[t.name];
        const r = (id: string) => reviewedTokens(id, k);
        return (
          <div>
            <dt>
              {t.name} <span data-tok={perTok((id) => `${done(t, id, k)}% done`)}>{done(t, tok0.id, k)}% done</span>
            </dt>
            <dd>
              <div class="nc-bar" aria-hidden="true">
                <span class="nc-seg nc-seg-sharded" style={`width: ${width(t.sharded, t.total)}`} />
              </div>
              <div class="nc-bar" aria-hidden="true">
                <span class="nc-seg nc-seg-reviewed" data-tok-width={perTok((id) => width(r(id).reviewed, r(id).total))} style={`width: ${width(r(tok0.id).reviewed, r(tok0.id).total)}`} />
              </div>
              <p>
                <span>{t.sharded} of {t.total} {t.unit} sharded</span>;{' '}
                <span data-tok={perTok((id) => `${n.format(r(id).reviewed)} of ${n.format(r(id).total)} tokens reviewed`)}>
                  {n.format(r(tok0.id).reviewed)} of {n.format(r(tok0.id).total)} tokens reviewed
                </span>
                . {t.note}
              </p>
            </dd>
          </div>
        );
      })
    }
  </dl>
  <ul class="nc-legend">
    <li><span class="nc-key nc-seg-sharded"></span>Documents sharded</li>
    <li><span class="nc-key nc-seg-reviewed"></span>Tokens reviewed</li>
    <li><span class="nc-key nc-seg-todo"></span>Not yet</li>
  </ul>

  <h3>The docs' size, before and after</h3>
  <p>
    What a reader, or a language model, has to take in: the documents this edition started from
    (the upstream snapshot <code>{sizes.before.label}</code>) and the shards that replaced them, each read whole as stored.
    Tokens depend on the model's tokenizer.
  </p>
  <p class="nc-size-pick">
    <label for="nc-tokenizer">Tokenizer</label>
    <select id="nc-tokenizer">
      {sizes.tokenizers.map((t: any) => <option value={t.id} data-note={t.note}>{t.name}</option>)}
    </select>
    <span class="nc-stat-note" id="nc-tokenizer-note">{tok0.note}</span>
  </p>
  <div class="nc-history-scroll">
    <table class="nc-sizes">
      <thead>
        <tr><th>Track</th><th>Before</th><th>Now</th><th>Tokens before</th><th>Tokens now</th><th>Change</th></tr>
      </thead>
      <tbody>
        {
          sizeRows.map((g: any) => (
            <tr class={g.name === 'All' ? 'nc-sizes-all' : undefined}>
              <td>{g.name}</td>
              <td>{n.format(g.before.files)} files, {n.format(g.before.words)} words</td>
              <td>{n.format(g.now.files)} files, {n.format(g.now.words)} words</td>
              {['before', 'now'].map((side) => (
                <td data-tok={JSON.stringify(Object.fromEntries(sizes.tokenizers.map((t: any) => [t.id, n.format(g[side][t.id])])))}>{n.format(g[side][tok0.id])}</td>
              ))}
              <td data-tok={JSON.stringify(Object.fromEntries(sizes.tokenizers.map((t: any) => [t.id, change(g.before[t.id], g.now[t.id])])))}>{change(g.before[tok0.id], g.now[tok0.id])}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="nc-stat-note">
    Before: the guides' HTML (the HOWTO and Writing Programs with NCURSES), the troff pages in <code>man/</code>, and the hacker's guide, <code>INSTALL</code> and READMEs, the Ada page and the announcement.
    Now: their shards under <code>docs/</code>. Words leave out markup. Measured by
    <a href={`${repoUrl}/blob/master/site/scripts/doc-sizes.py`}><code>doc-sizes.py</code></a>; rerun it after a change to the docs.
  </p>
  <script>
    const pick = document.getElementById('nc-tokenizer') as HTMLSelectElement | null;
    pick?.addEventListener('change', () => {
      for (const el of document.querySelectorAll<HTMLElement>('.nc-progress [data-tok]')) el.textContent = JSON.parse(el.dataset.tok!)[pick.value];
      for (const el of document.querySelectorAll<HTMLElement>('.nc-progress [data-tok-width]')) el.style.width = JSON.parse(el.dataset.tokWidth!)[pick.value];
      const note = document.getElementById('nc-tokenizer-note');
      if (note) note.textContent = pick.selectedOptions[0]?.dataset.note ?? '';
    });
  </script>

  <h3>What it took so far</h3>
  <p>
    One agent session did the work, with the maintainer reviewing and merging each pull request.
    Figures are as of {date(s.asOf)}.
  </p>
  <dl class="nc-stats">
    <div><dt>Tokens</dt><dd>{compact.format(tokens)}</dd><dd class="nc-stat-note">{compact.format(s.outputTokens)} output, {compact.format(s.inputTokens)} input, {compact.format(s.cacheReadTokens)} read from the prompt cache, {compact.format(s.cacheWriteTokens)} written to it</dd></div>
    <div><dt>API cost*</dt><dd>${n.format(Math.round(s.costUsd))}</dd><dd class="nc-stat-note">At list prices, as the session reports it. *Not what was paid: the work ran on a flat-rate Claude subscription that includes this usage.</dd></div>
    <div><dt>Wall time</dt><dd>{days(elapsed)}</dd><dd class="nc-stat-note">From the first request to {date(s.asOf)}</dd></div>
    <div><dt>Agent working time</dt><dd>{hours(s.agentActiveSeconds)}</dd><dd class="nc-stat-note">Gaps of 5 minutes or less between the agent's steps; waits for CI and for the maintainer aren't counted</dd></div>
    <div><dt>Maintainer time</dt><dd>{hours(s.maintainerSeconds)}</dd><dd class="nc-stat-note">{s.maintainerMessages} messages; gaps of 15 minutes or less between them, so reading time is undercounted</dd></div>
    {merged !== undefined && <div><dt>Pull requests merged</dt><dd>{merged}</dd><dd class="nc-stat-note">Each one reviewed and merged by the maintainer</dd></div>}
    <div><dt>Errata recorded</dt><dd>{errata}</dd><dd class="nc-stat-note">{fixed} errors in the original text, each checked against the library; see <a href="appendix/">Errata</a></dd></div>
  </dl>

  <h3>Checking these figures</h3>
  <p>
    Every count above comes from git, at build time.
    The history below keeps the same counts for each merged pull request, taken at its merge commit, in
    <a href={`${repoUrl}/blob/master/site/data/migration-history.json`}><code>migration-history.json</code></a>.
    Which pull request reviewed each document is listed in
    <a href={`${repoUrl}/blob/master/site/data/migration-units.csv`}><code>migration-units.csv</code></a>.
    To check both against the repository, clone it and run:
  </p>
  <pre><code>node site/scripts/migration-history.mjs verify</code></pre>
  <p>
    It recounts every row from git and fails on any difference.
    It also checks each review claim: the pull request merged, changed that document, and recorded its corrections in the errata.
    CI runs it on every pull request.
    The token and cost figures are the exception. They come from the agent's session API, and the repository keeps each response's numbers in
    <a href={`${repoUrl}/tree/master/site/data/session`}><code>site/data/session</code></a>, along with the session's time totalled by day, which the time figures are the sums of.
    <code>node site/scripts/migration-stats.mjs verify</code> checks the figures above against those files.
  </p>
  <details class="nc-history">
    <summary>Progress at each merged pull request</summary>
    <div class="nc-history-scroll">
    <table>
      <thead>
        <tr><th>Pull request</th><th>Merged</th><th>Done (documents)</th><th>Guides</th><th>Manual pages</th><th>Contributor docs</th><th>Errata</th></tr>
      </thead>
      <tbody>
        {
          history.map((r: any) => (
            <tr>
              <td><a href={`${repoUrl}/pull/${r.pr}`}>#{r.pr}</a></td>
              <td>{date(r.mergedAt)}</td>
              <td>{r.done}%</td>
              <td>{r.guides.sharded}/{r.guides.reviewed} of {r.guides.total}</td>
              <td>{r.man.sharded}/{r.man.reviewed} of {r.man.total}</td>
              <td>{r.contributor.sharded}/{r.contributor.reviewed} of {r.contributor.total}</td>
              <td>{r.errata.rows}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    </div>
    <p class="nc-stat-note">Each track shows sharded/reviewed of its total. The history counts review in documents, since tokens are measured only for the current shards.</p>
  </details>
</section>

<style>
  .nc-progress {
    margin-top: 2rem;
  }
  .nc-progress dd {
    margin-inline-start: 0;
  }
  .nc-bar {
    display: flex;
    height: 0.9rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
  }
  .nc-bar-total {
    height: 1.5rem;
  }
  .nc-seg {
    display: block;
    height: 100%;
  }
  .nc-seg-reviewed {
    background: var(--sl-color-accent);
  }
  .nc-seg-sharded {
    background: color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-gray-6));
  }
  .nc-seg-todo {
    background: var(--sl-color-gray-6);
  }
  .nc-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
  }
  .nc-legend li {
    margin: 0;
  }
  .nc-key {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    margin-inline-end: 0.4em;
    vertical-align: -0.1em;
    border: 1px solid var(--sl-color-gray-4);
  }
  .nc-tracks dt {
    display: flex;
    justify-content: space-between;
    font-weight: 600;
  }
  .nc-tracks dd {
    margin: 0.25rem 0 0;
  }
  .nc-tracks .nc-bar + .nc-bar,
  .nc-bar-label + .nc-bar {
    margin-top: 0.2rem;
  }
  .nc-bar-label {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
  }
  .nc-tracks dd p {
    margin-top: 0.25rem;
    font-size: var(--sl-text-sm);
  }
  .nc-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1rem;
  }
  .nc-stats > div {
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }
  .nc-stats dt {
    font-size: var(--sl-text-sm);
  }
  .nc-stats dd {
    margin: 0;
    font-size: var(--sl-text-2xl);
    font-weight: 600;
  }
  .nc-size-pick {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
  }
  .nc-size-pick label {
    font-weight: 600;
  }
  .nc-sizes {
    font-size: var(--sl-text-sm);
  }
  .nc-sizes td,
  .nc-sizes th {
    white-space: nowrap;
  }
  .nc-sizes td:nth-child(n + 4) {
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  .nc-sizes-all td {
    font-weight: 600;
  }
  .nc-size-pick .nc-stat-note,
  .nc-progress > .nc-stat-note {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .nc-history summary {
    cursor: pointer;
    font-weight: 600;
  }
  .nc-progress pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
  }
  .nc-history-scroll {
    max-width: 100%;
    overflow-x: auto;
  }
  .nc-history table {
    font-size: var(--sl-text-sm);
  }
  .nc-history td,
  .nc-history th {
    white-space: nowrap;
  }
  .nc-stats dd.nc-stat-note,
  .nc-history .nc-stat-note {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    font-weight: 400;
    color: var(--sl-color-gray-2);
  }
</style>
