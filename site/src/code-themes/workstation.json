{
  "name": "ncurses-workstation",
  "type": "light",
  "colors": {
    "editor.background": "#e4e4df",
    "editor.foreground": "#161616"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f5f58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.other.lt-gt.include",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#8a3b12"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.language"
      ],
      "settings": {
        "foreground": "#1f6b34"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "keyword.control.directive.include"
      ],
      "settings": {
        "foreground": "#6b3f8f"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#22577a",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#22577a"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#000000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#161616"
      }
    }
  ]
}
