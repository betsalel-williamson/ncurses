{
  "name": "ncurses-textmode",
  "type": "dark",
  "colors": {
    "editor.background": "#000088",
    "editor.foreground": "#d4d4d4"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a8a8a8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.other.lt-gt.include",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#55ff55"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.language"
      ],
      "settings": {
        "foreground": "#55ffff"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "keyword.control.directive.include"
      ],
      "settings": {
        "foreground": "#ff55ff"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#ffff55",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    }
  ]
}
