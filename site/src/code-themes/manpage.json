{
  "name": "ncurses-manpage",
  "type": "light",
  "colors": {
    "editor.background": "#f1f1e8",
    "editor.foreground": "#1b1b1b"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#55554e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.other.lt-gt.include",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#1b1b1b"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.language"
      ],
      "settings": {
        "foreground": "#1b1b1b"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "keyword.control.directive.include"
      ],
      "settings": {
        "foreground": "#1b1b1b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#1b1b1b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#1b1b1b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#1b1b1b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1b1b1b"
      }
    }
  ]
}
