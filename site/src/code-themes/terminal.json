{
  "name": "ncurses-terminal",
  "type": "dark",
  "colors": {
    "editor.background": "#1c1a15",
    "editor.foreground": "#e8d9b0"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a39470",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted.other.lt-gt.include",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffcf70"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ff9e3d"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor",
        "keyword.control.directive.include"
      ],
      "settings": {
        "foreground": "#e0a040"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#ffb000",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#ffb000"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#ffe29a",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation",
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#e8d9b0"
      }
    }
  ]
}
